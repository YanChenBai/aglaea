{
  "compilerOptions": {
    "strict": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "DOM"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node", "@nativescript/types"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "paths": { "vue": ["./node_modules/nativescript-vue"] }
  },
  "vueCompilerOptions": { "target": 3, "lib": "nativescript-vue" },
  "include": ["src", "types", "tests"]
}
