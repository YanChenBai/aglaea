{
  "name": "@aglaea/server",
  "version": "0.0.0",
  "description": "Aglaea in-memory synchronization server.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "vp test",
    "check": "vp check",
    "build": "bun build src/index.ts --target=bun --outdir=dist --minify",
    "typecheck": "vp exec tsc --noEmit"
  },
  "dependencies": {
    "@aglaea/shared": "workspace:*",
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/openapi": "^1.4.16",
    "@elysiajs/static": "^1.4.10",
    "@sinclair/typebox": "^0.34.41",
    "elysia": "^1.4.30",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.2",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
